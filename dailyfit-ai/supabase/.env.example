# Edge Function secrets (local: `supabase functions serve --env-file supabase/.env.local`;
# production: `supabase secrets set KEY=value`). Never commit real values.
AI_PROVIDER=anthropic            # anthropic | openai
AI_MODEL_PLANNER=claude-opus-5-5 # owner decision — see README cost table (e.g. claude-haiku-5-5 is ~40x cheaper)
AI_MODEL_COACH=claude-opus-5-5
AI_TIMEOUT_MS=20000
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ALLOW_SAMPLE_FOOD=false          # true only in local/staging
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are injected by Supabase automatically.
